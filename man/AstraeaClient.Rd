  a <- client$create_node(c("Person"), list(name = "Alice"))
  b <- client$create_node(c("Person"), list(name = "Bob"))
  eid <- client$create_edge(
    source    = a,
    target    = b,
    edge_type = "KNOWS",
    weight    = 0.9
  )
  client$disconnect()
}
}
}
\if{html}{\out{</div>}}

}

